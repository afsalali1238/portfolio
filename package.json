{
  "name": "your-creative-showcase",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "build": "vite build && tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test src/components/*.test.ts src/components/scrollytelling/*.test.ts",
    "test:browser": "node qa/smoke.mjs",
    "test:hardening": "node qa/hardening.mjs",
    "test:all": "pnpm test && pnpm test:browser && pnpm test:hardening",
    "audit": "pnpm audit --audit-level=low",
    "format": "prettier --write src 'qa/*.mjs' vite.config.ts tsconfig.json package.json '*.md'",
    "format:check": "prettier --check src 'qa/*.mjs' vite.config.ts tsconfig.json package.json '*.md'"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/instrument-serif": "5.3.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.3.0",
    "nitro": "3.0.261103-rc",
    "prettier": "3.8.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ]
  }
}
